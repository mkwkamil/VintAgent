# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
JWT_SECRET=change-me-long-random-secret
JWT_EXPIRE_HOURS=168

# Scraper
MAX_THREADS=10
POLL_MIN_SECONDS=10
POLL_MAX_SECONDS=15
VINTED_BASE_URL=https://www.vinted.pl
VINTED_IMPERSONATE=chrome,chrome136,chrome142
# Optional residential proxy — best way to keep sessions alive on GCP without a phone
# VINTED_PROXY=http://user:pass@host:port
VINTED_PROXY=
SEEN_IDS_LIMIT=300
BLOCKED_BACKOFF_MIN_SECONDS=60
BLOCKED_BACKOFF_MAX_SECONDS=180
STATS_RETENTION_HOURS=168

# Keep-alive (HTTP only; no Chromium needed)
BROWSER_BOOTSTRAP_ENABLED=false
SESSION_CHECK_INTERVAL_SECONDS=60
SESSION_REFRESH_MARGIN_SECONDS=1800
SESSION_FORCE_REFRESH_SECONDS=2700
BROWSER_MIN_INTERVAL_SECONDS=120
BROWSER_TIMEOUT_SECONDS=90
BROWSER_EXECUTABLE_PATH=

# Public URL of this VintAgent (Telegram rescue button)
# Example: http://34.x.x.x:8000
PUBLIC_BASE_URL=
SESSION_RESCUE_TTL_SECONDS=900
SESSION_RESCUE_ALERT_COOLDOWN_SECONDS=1800

# Telegram (forum group with Topics; bot must be admin)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Paths / API
CORS_ORIGINS=*
DATA_FILE=/app/data/data.json
SESSION_FILE=/app/data/session.json
