# Admin login (frontend dashboard)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
JWT_SECRET=change-me-long-random-secret
JWT_EXPIRE_HOURS=168

# Scraper
MAX_THREADS=6
POLL_MIN_SECONDS=10
POLL_MAX_SECONDS=15
VINTED_BASE_URL=https://www.vinted.pl
# curl_cffi impersonation profiles (comma separated), rotated on every session refresh
VINTED_IMPERSONATE=chrome,chrome136,chrome142
# Wymagane, gdy Cloudflare odpowiada wyzwaniem JS na anonimowe zapytania.
# Skopiuj nagłówek Cookie z zalogowanej przeglądarki (DevTools > Network > dowolne
# zapytanie do vinted.pl > Request Headers > Cookie), np.:
# VINTED_COOKIE=access_token_web=...; anon_id=...; cf_clearance=...
VINTED_COOKIE=
# Token dostępu żyje 2 h, a refresh token 7 dni (oba rotują przy odnowieniu).
# Aplikacja odnawia sesję z takim wyprzedzeniem przed wygaśnięciem i zapisuje
# nowe tokeny do data/session.json, więc wystarczy jedno wklejenie cookies.
SESSION_REFRESH_MARGIN_SECONDS=600
SEEN_IDS_LIMIT=300
BLOCKED_BACKOFF_MIN_SECONDS=60
BLOCKED_BACKOFF_MAX_SECONDS=180

# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# API
CORS_ORIGINS=*
DATA_FILE=/app/data/data.json
