# Admin login (frontend dashboard)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
JWT_SECRET=change-me-long-random-secret
JWT_EXPIRE_HOURS=168

# Scraper
MAX_THREADS=10
POLL_MIN_SECONDS=10
POLL_MAX_SECONDS=15
VINTED_BASE_URL=https://www.vinted.pl
# curl_cffi impersonation profiles (comma separated), rotated on every session refresh
VINTED_IMPERSONATE=chrome,chrome136,chrome142
# Sesja Vinted jest w pełni automatyczna: cookies pobiera headless Chromium
# (jedyne, co przechodzi wyzwanie JS Cloudflare) i zapisuje je w data/session.json.
# Przeglądarka startuje tylko wtedy, gdy nie da się odnowić sesji zwykłym HTTP.
BROWSER_BOOTSTRAP_ENABLED=true
# Minimalny odstęp między uruchomieniami przeglądarki (ochrona przed pętlą startów)
BROWSER_MIN_INTERVAL_SECONDS=120
BROWSER_TIMEOUT_SECONDS=90
# Ścieżka do własnego Chromium; puste = wersja zainstalowana przez Playwright
BROWSER_EXECUTABLE_PATH=
# Co ile sekund watchdog sprawdza, czy sesja nadal jest ważna
SESSION_CHECK_INTERVAL_SECONDS=300
# Z jakim wyprzedzeniem przed wygaśnięciem odnawiać token dostępu
SESSION_REFRESH_MARGIN_SECONDS=600
# Ile godzin historii statystyk trzymać dla każdego linku (168 = 7 dni)
STATS_RETENTION_HOURS=168
SEEN_IDS_LIMIT=300
BLOCKED_BACKOFF_MIN_SECONDS=60
BLOCKED_BACKOFF_MAX_SECONDS=180

# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# API
CORS_ORIGINS=*
DATA_FILE=/app/data/data.json
