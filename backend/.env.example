# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
JWT_SECRET=change-me-long-random-secret
JWT_EXPIRE_HOURS=168

# Scraper
MAX_THREADS=10
POLL_MIN_SECONDS=10
POLL_MAX_SECONDS=15
VINTED_BASE_URL=https://www.vinted.pl
VINTED_IMPERSONATE=chrome,chrome136,chrome142
VINTED_PROXY=
SEEN_IDS_LIMIT=300
BLOCKED_BACKOFF_MIN_SECONDS=60
BLOCKED_BACKOFF_MAX_SECONDS=180
STATS_RETENTION_HOURS=168

# Session — Chrome CDP (jak CookieScraper)
SESSION_CHECK_INTERVAL_SECONDS=60
SESSION_REFRESH_MARGIN_SECONDS=1800
SESSION_FORCE_REFRESH_SECONDS=2700
BROWSER_BOOTSTRAP_ENABLED=true
CHROME_CDP_URL=http://127.0.0.1:9222
# Profil Chrome (osobny od codziennego)
# BROWSER_PROFILE_DIR=data/chrome_cdp
# BROWSER_EXECUTABLE_PATH=
BROWSER_TIMEOUT_SECONDS=300

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Paths — lokalnie (uvicorn). Docker Compose nadpisuje na /app/data/*
CORS_ORIGINS=*
DATA_FILE=data/data.json
SESSION_FILE=data/session.json
